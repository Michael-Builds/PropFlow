# App
NODE_ENV=
PORT=
API_PREFIX=
API_VERSION=
APP_NAME=
APP_URL=

# Database (Neon Postgres)
DATABASE_URL=

# Auth (JWT)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# Redis (local Docker, no password required)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=

# Rate limiting
THROTTLE_SHORT_TTL_MS=
THROTTLE_SHORT_LIMIT=
THROTTLE_MEDIUM_TTL_MS=
THROTTLE_MEDIUM_LIMIT=
THROTTLE_LONG_TTL_MS=
THROTTLE_LONG_LIMIT=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

# AWS CloudFront
AWS_CLOUDFRONT_DOMAIN=

# Audit
AUDIT_LOG_ENABLED=

# Frontend (Paystack return URL)
FRONTEND_URL=

# Paystack 
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=

# Customer bears gateway fees. Ghana local card/MoMo is typically 1.95%.
PAYSTACK_FEE_PERCENT=
PAYSTACK_FEE_FLAT=0

# Optional cap in GHS. Leave empty for no cap.
PAYSTACK_FEE_CAP=
PAYSTACK_CALLBACK_URL=
PAYSTACK_CHANNELS=

# Optional AES key for tenant phone / emergency contact
PII_ENCRYPTION_KEY=

# Mail (log-only unless SMTP_HOST is set)
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Platform operator seed
PLATFORM_ADMIN_EMAIL=

