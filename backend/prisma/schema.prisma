generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  platform_admin
  owner
  manager
  finance
  vendor
  tenant
}

enum EntityType {
  property
  unit
  tenant
  lease
  ticket
}

enum PlatformAvailabilityMode {
  live
  maintenance
  coming_soon
}

enum ConversationType {
  tenant_ops
  owner_platform
}

enum ConversationStatus {
  open
  closed
}

model Organization {
  id                      String    @id @default(cuid())
  name                    String
  status                  String    @default("active")
  phone                   String?
  address                 String?
  city                    String?
  country                 String?   @default("GH")
  onboardingComplete      Boolean   @default(true)
  onboardingCompletedAt   DateTime?
  createdAt               DateTime  @default(now())

  users      User[]
  properties Property[]
}

model User {
  id                 String    @id @default(cuid())
  orgId              String?
  email              String    @unique
  fullName           String?
  role               UserRole
  passwordHash       String
  status             String    @default("active")
  mustChangePassword Boolean   @default(false)
  tenantId           String?
  vendorId           String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  organization        Organization?        @relation(fields: [orgId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  location    String?
  addressJson Json?
  timezone    String?
  type        String?
  manager     String?
  yearBuilt   Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  blocks       Block[]
  units        Unit[]
  leases       Lease[]
  tickets      Ticket[]

  @@index([orgId, status])
}

model Block {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  name       String
  status     String   @default("active")
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@unique([propertyId, name])
  @@index([orgId, propertyId])
}

model Unit {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  blockId    String?
  unitCode   String
  type       String?
  floor      Int?
  sqm        Decimal? @db.Decimal(10, 2)
  rentAmount Decimal  @db.Decimal(12, 2)
  currency   String   @default("GHS")
  status     String   @default("vacant")
  utilityJson Json?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  block    Block?   @relation(fields: [blockId], references: [id])
  leases   Lease[]
  tickets  Ticket[]

  @@unique([orgId, propertyId, unitCode])
  @@index([orgId, status])
}

model Tenant {
  id               String   @id @default(cuid())
  orgId            String
  fullName         String
  email            String?
  phone            String?
  occupation       String?
  emergencyContact String?
  status           String   @default("active")
  kycStatus        String   @default("pending")
  createdAt        DateTime @default(now())

  leases   Lease[]
  invoices Invoice[]
  tickets  Ticket[]

  @@index([orgId, status])
}

model Lease {
  id           String   @id @default(cuid())
  orgId        String
  propertyId   String
  unitId       String
  tenantId     String
  startDate    DateTime
  endDate      DateTime
  rentAmount   Decimal  @db.Decimal(12, 2)
  dueDay       Int
  billingCycle String   @default("monthly")
  status       String   @default("active")
  version      Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  unit     Unit          @relation(fields: [unitId], references: [id])
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  invoices Invoice[]
  changes  LeaseChange[]

  @@index([orgId, status])
  @@index([unitId, status])
  @@index([tenantId])
}

model LeaseChange {
  id          String   @id @default(cuid())
  orgId       String
  leaseId     String
  changeType  String
  fromVersion Int?
  toVersion   Int?
  snapshotJson Json?
  actorUserId String?
  notes       String?
  createdAt   DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([orgId, createdAt])
}

model Invoice {
  id             String    @id @default(cuid())
  orgId          String
  leaseId        String
  tenantId       String
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  amountDue      Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @db.Decimal(12, 2) @default(0)
  balance        Decimal   @db.Decimal(12, 2)
  currency       String    @default("GHS")
  status         String    @default("due")
  checkoutToken  String    @unique @default(cuid())
  notes           String?
  lastReminderAt  DateTime?
  promiseToPayAt  DateTime?
  promisedAmount  Decimal?  @db.Decimal(12, 2)
  escalationLevel String?
  escalatedAt     DateTime?
  createdAt       DateTime  @default(now())

  lease    Lease     @relation(fields: [leaseId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@index([orgId, status])
  @@index([leaseId])
  @@index([tenantId])
}

model ArrearsSnapshot {
  id           String   @id @default(cuid())
  orgId        String
  tenantId     String
  leaseId      String
  invoiceId    String?
  bucket       String
  balance      Decimal  @db.Decimal(12, 2)
  snapshotDate DateTime @default(now())

  @@index([orgId, snapshotDate])
  @@index([tenantId])
}

model Payment {
  id            String    @id @default(cuid())
  orgId         String
  invoiceId     String
  amount        Decimal   @db.Decimal(12, 2)
  feeAmount     Decimal   @db.Decimal(12, 2) @default(0)
  chargedAmount Decimal   @db.Decimal(12, 2)
  currency      String    @default("GHS")
  method        String
  provider      String    @default("paystack")
  direction     String    @default("in")
  status        String    @default("pending")
  reference     String    @unique
  providerRef   String?   @unique
  checkoutUrl   String?
  accessCode    String?
  paidAt        DateTime?
  createdBy     String?
  metadataJson  Json?
  createdAt     DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([orgId, status])
  @@index([invoiceId])
}

model Ticket {
  id             String    @id @default(cuid())
  orgId          String
  propertyId     String
  unitId         String?
  tenantId       String?
  category       String
  priority       String
  status         String    @default("open")
  slaDueAt       DateTime?
  assigneeUserId String?
  vendorId       String?
  costAmount     Decimal?  @db.Decimal(12, 2)
  notes          String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  unit     Unit?         @relation(fields: [unitId], references: [id])
  tenant   Tenant?       @relation(fields: [tenantId], references: [id])
  vendor   Vendor?       @relation(fields: [vendorId], references: [id])
  events   TicketEvent[]

  @@index([orgId, status])
  @@index([assigneeUserId])
}

model TicketEvent {
  id          String   @id @default(cuid())
  orgId       String
  ticketId    String
  eventType   String
  payloadJson Json?
  actorUserId String?
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Vendor {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  contactJson     Json?
  specialtiesJson Json?
  status          String   @default("active")
  createdAt       DateTime @default(now())

  tickets Ticket[]

  @@index([orgId, status])
}

model Document {
  id           String     @id @default(cuid())
  orgId        String
  entityType   EntityType
  entityId     String
  docType      String
  fileUrl      String
  expiresAt    DateTime?
  status       String     @default("valid")
  metadataJson Json?
  createdAt    DateTime   @default(now())

  @@index([orgId, entityType, entityId])
  @@index([orgId, status])
}

model ComplianceRule {
  id           String     @id @default(cuid())
  orgId        String
  entityType   EntityType
  docType      String
  required     Boolean    @default(true)
  validityDays Int?

  @@unique([orgId, entityType, docType])
  @@index([orgId, entityType])
}

model Notification {
  id          String    @id @default(cuid())
  orgId       String
  userId      String?
  channel     String
  type        String
  payloadJson Json
  status      String    @default("queued")
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, userId, status])
}

model PlatformAvailability {
  id           String                   @id @default("default")
  mode         PlatformAvailabilityMode @default(live)
  title        String                   @default("")
  message      String                   @default("")
  supportEmail String?
  updatedBy    String?
  updatedAt    DateTime                 @updatedAt
}

model Conversation {
  id        String             @id @default(cuid())
  orgId     String?
  type      ConversationType
  subject   String?
  status    ConversationStatus @default(open)
  createdBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([orgId, type, updatedAt])
  @@index([type, updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           UserRole
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId  String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
}
