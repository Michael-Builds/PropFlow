generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
  finance
  vendor
  tenant
}

enum EntityType {
  property
  unit
  tenant
  lease
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())

  users      User[]
  properties Property[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  role         UserRole
  passwordHash String
  status       String   @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
}

model Property {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  addressJson Json?
  timezone   String?
  status     String   @default("active")
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  units        Unit[]
}

model Unit {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  unitCode   String
  type       String?
  rentAmount Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  status     String   @default("vacant")
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
}

model Tenant {
  id        String   @id @default(cuid())
  orgId     String
  fullName  String
  email     String?
  phone     String?
  status    String   @default("active")
  kycStatus String   @default("pending")
  createdAt DateTime @default(now())
}

model Lease {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  unitId     String
  tenantId   String
  startDate  DateTime
  endDate    DateTime
  rentAmount Decimal  @db.Decimal(12, 2)
  dueDay     Int
  status     String   @default("active")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  orgId       String
  leaseId     String
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  amountDue   Decimal  @db.Decimal(12, 2)
  amountPaid  Decimal  @db.Decimal(12, 2) @default(0)
  balance     Decimal  @db.Decimal(12, 2)
  status      String   @default("due")
  createdAt   DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  orgId     String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  reference String?
  paidAt    DateTime
  createdBy String?
  createdAt DateTime @default(now())
}

model Ticket {
  id         String   @id @default(cuid())
  orgId      String
  propertyId String
  unitId     String?
  tenantId   String?
  category   String
  priority   String
  status     String   @default("open")
  slaDueAt   DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime @default(now())
}

model Vendor {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  contactJson    Json?
  specialtiesJson Json?
  status         String   @default("active")
  createdAt      DateTime @default(now())
}

model Document {
  id          String    @id @default(cuid())
  orgId       String
  entityType  EntityType
  entityId    String
  docType     String
  fileUrl     String
  expiresAt   DateTime?
  status      String    @default("valid")
  metadataJson Json?
  createdAt   DateTime  @default(now())
}

model ComplianceRule {
  id           String   @id @default(cuid())
  orgId        String
  entityType   EntityType
  docType      String
  required     Boolean  @default(true)
  validityDays Int?
}

model Notification {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  channel    String
  type       String
  payloadJson Json
  status     String   @default("queued")
  sentAt     DateTime?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())
}
