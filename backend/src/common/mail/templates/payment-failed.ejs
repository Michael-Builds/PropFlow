<%- include('partials/header') %>

<p class="email-eyebrow email-eyebrow--danger">Payment failed</p>
<h1 class="email-title">Payment could not be completed</h1>
<p class="email-copy">
  Hi<% if (fullName) { %> <%= fullName %><% } %>, a payment attempt on PropFlow did not go through.
</p>
<table class="email-panel" id="propflow-payment-failed" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="email-panel__inner">
      <p class="email-panel__label">Attempt details</p>
      <% if (reference) { %><p class="email-panel__row"><span class="email-strong">Reference:</span> <%= reference %></p><% } %>
      <% if (invoiceId) { %><p class="email-panel__row"><span class="email-strong">Invoice:</span> <%= invoiceId %></p><% } %>
      <% if (amountLabel) { %><p class="email-panel__row"><span class="email-strong">Amount:</span> <%= amountLabel %></p><% } %>
    </td>
  </tr>
</table>
<table class="email-cta-wrap" role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      <a class="email-cta" id="propflow-payment-failed-cta" href="<%= actionUrl || frontendUrl %>">Try again in PropFlow</a>
    </td>
  </tr>
</table>
<p class="email-muted">If funds were deducted by your bank or MoMo wallet, they are usually reversed automatically. Contact support if they don’t return.</p>

<%- include('partials/footer') %>
