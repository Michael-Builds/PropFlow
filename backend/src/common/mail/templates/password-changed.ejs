<%- include('partials/header') %>

  <p class="email-eyebrow email-eyebrow--success">Security update</p>
  <h1 class="email-title">Password updated</h1>
  <p class="email-copy">
    Hi<% if (fullName) { %>
      <%= fullName %>
        <% } %>, your PropFlow password was changed successfully.
          You can sign in with your new credentials right away.
  </p>
  <table class="email-cta-wrap" role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center">
        <a class="email-cta" id="propflow-login-cta" href="<%= loginUrl %>">Sign in to PropFlow</a>
      </td>
    </tr>
  </table>
  <p class="email-muted">
    If you didn’t make this change, contact support immediately so we can secure your account.
  </p>

  <%- include('partials/footer') %>