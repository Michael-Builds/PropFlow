<%- include('partials/header') %>

  <p class="email-eyebrow">Password reset</p>
  <h1 class="email-title">Reset your password</h1>
  <p class="email-copy">
    Hi<% if (fullName) { %>
      <%= fullName %>
        <% } %>, we received a request to reset the password for your PropFlow account.
          This secure link expires in <span class="email-strong">one hour</span>.
  </p>
  <table class="email-cta-wrap" role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center">
        <a class="email-cta" id="propflow-reset-cta" href="<%= resetUrl %>">Reset password</a>
      </td>
    </tr>
  </table>
  <p class="email-muted">Or copy this link into your browser:</p>
  <p class="email-link-block">
    <a class="email-link" href="<%= resetUrl %>">
      <%= resetUrl %>
    </a>
  </p>
  <p class="email-muted">
    If you didn’t ask for this, you can ignore this email. Your password will stay the same.
  </p>

  <%- include('partials/footer') %>